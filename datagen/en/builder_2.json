{"id": 19, "vi": "đang", "note": "Thì hiện tại tiếp diễn: am/is/are + động từ thêm -ing để nói hành động đang diễn ra.", "pivot": {"t": "am / is / are + -ing", "ph": "EM / IZ / A + INH"}, "branches": [{"steps": [{"t": "eat", "ph": "IT", "vi": "ăn", "hl": []}, {"t": "am eating", "ph": "EM I-TINH", "vi": "đang ăn", "hl": ["am eating"]}, {"t": "I am eating lunch now.", "ph": "AI EM I-TINH LÁNCH NAO", "vi": "Tôi đang ăn trưa.", "hl": ["am eating"], "tokens": ["I", "am", "eating", "lunch", "now"]}]}, {"steps": [{"t": "wait", "ph": "UÂYT", "vi": "đợi", "hl": []}, {"t": "are waiting", "ph": "A UÂY-TINH", "vi": "đang đợi", "hl": ["are waiting"]}, {"t": "We are waiting for the bus.", "ph": "UY A UÂY-TINH PHO ĐƠ BÁT", "vi": "Chúng tôi đang đợi xe buýt.", "hl": ["are waiting"], "tokens": ["We", "are", "waiting", "for", "the", "bus"]}]}, {"steps": [{"t": "sleep", "ph": "SLIP", "vi": "ngủ", "hl": []}, {"t": "is sleeping", "ph": "IZ SLI-PINH", "vi": "đang ngủ", "hl": ["is sleeping"]}, {"t": "The baby is sleeping now.", "ph": "ĐƠ BÂY-BI IZ SLI-PINH NAO", "vi": "Em bé đang ngủ.", "hl": ["is sleeping"], "tokens": ["The", "baby", "is", "sleeping", "now"]}]}]},
{"id": 20, "vi": "rồi", "note": "Dùng thì hiện tại hoàn thành have/has + quá khứ phân từ (V3), thường kèm already, để nói việc đã xong rồi.", "pivot": {"t": "already", "ph": "OL-RE-ĐI"}, "branches": [{"steps": [{"t": "eaten", "ph": "I-TƠN", "vi": "ăn (V3)", "hl": []}, {"t": "have already eaten", "ph": "HEV OL-RE-ĐI I-TƠN", "vi": "ăn rồi", "hl": ["have already"]}, {"t": "I have already eaten.", "ph": "AI HEV OL-RE-ĐI I-TƠN", "vi": "Tôi ăn rồi.", "hl": ["have already"], "tokens": ["I", "have", "already", "eaten"]}]}, {"steps": [{"t": "paid", "ph": "PÂYĐ", "vi": "đã trả", "hl": []}, {"t": "already paid", "ph": "OL-RE-ĐI PÂYĐ", "vi": "trả rồi", "hl": ["already"]}, {"t": "We already paid the bill.", "ph": "UY OL-RE-ĐI PÂYĐ ĐƠ BIL", "vi": "Chúng tôi trả hóa đơn rồi.", "hl": ["already"], "tokens": ["We", "already", "paid", "the", "bill"]}]}, {"steps": [{"t": "left", "ph": "LEPHT", "vi": "rời đi", "hl": []}, {"t": "has already left", "ph": "HEZ OL-RE-ĐI LEPHT", "vi": "đã đi rồi", "hl": ["has already"]}, {"t": "The bus has already left.", "ph": "ĐƠ BÁT HEZ OL-RE-ĐI LEPHT", "vi": "Xe buýt đi mất rồi.", "hl": ["has already"], "tokens": ["The", "bus", "has", "already", "left"]}]}]},
{"id": 21, "vi": "chưa", "note": "Phủ định: haven't/hasn't + V3 ... yet (chưa làm gì); câu hỏi: Have you + V3 ... yet? (đã ... chưa?); với tính từ: not ... yet.", "pivot": {"t": "not yet", "ph": "NÓT YÉT"}, "branches": [{"steps": [{"t": "eaten", "ph": "I-TƠN", "vi": "ăn (V3)", "hl": []}, {"t": "haven't eaten yet", "ph": "HE-VƠNT I-TƠN YÉT", "vi": "chưa ăn", "hl": ["haven't", "yet"]}, {"t": "I haven't eaten yet.", "ph": "AI HE-VƠNT I-TƠN YÉT", "vi": "Tôi chưa ăn.", "hl": ["haven't", "yet"], "tokens": ["I", "haven't", "eaten", "yet"]}]}, {"steps": [{"t": "booked", "ph": "BÚCT", "vi": "đã đặt", "hl": []}, {"t": "have you booked", "ph": "HEV YU BÚCT", "vi": "bạn đã đặt chưa", "hl": ["have"]}, {"t": "Have you booked a room yet?", "ph": "HEV YU BÚCT Ơ RUM YÉT", "vi": "Bạn đã đặt phòng chưa?", "hl": ["Have", "yet"], "tokens": ["Have", "you", "booked", "a", "room", "yet"]}]}, {"steps": [{"t": "ready", "ph": "RE-ĐI", "vi": "sẵn sàng", "hl": []}, {"t": "not ready yet", "ph": "NÓT RE-ĐI YÉT", "vi": "chưa xong", "hl": ["not", "yet"]}, {"t": "The room is not ready yet.", "ph": "ĐƠ RUM IZ NÓT RE-ĐI YÉT", "vi": "Phòng chưa dọn xong.", "hl": ["not", "yet"], "tokens": ["The", "room", "is", "not", "ready", "yet"]}]}]},
{"id": 22, "vi": "rất", "note": "very + tính từ = rất ...; very much đặt cuối câu, sau động từ (thank you very much, like it very much).", "pivot": {"t": "very", "ph": "VE-RI"}, "branches": [{"steps": [{"t": "hot", "ph": "HÓT", "vi": "nóng", "hl": []}, {"t": "very hot", "ph": "VE-RI HÓT", "vi": "rất nóng", "hl": ["very"]}, {"t": "It is very hot today.", "ph": "IT IZ VE-RI HÓT TU-ĐÂY", "vi": "Hôm nay trời rất nóng.", "hl": ["very"], "tokens": ["It", "is", "very", "hot", "today"]}]}, {"steps": [{"t": "beautiful", "ph": "BIU-TI-PHƠL", "vi": "đẹp", "hl": []}, {"t": "very beautiful", "ph": "VE-RI BIU-TI-PHƠL", "vi": "rất đẹp", "hl": ["very"]}, {"t": "This beach is very beautiful.", "ph": "ĐIS BICH IZ VE-RI BIU-TI-PHƠL", "vi": "Bãi biển này rất đẹp.", "hl": ["very"], "tokens": ["This", "beach", "is", "very", "beautiful"]}]}, {"steps": [{"t": "much", "ph": "MÂCH", "vi": "nhiều", "hl": []}, {"t": "very much", "ph": "VE-RI MÂCH", "vi": "rất nhiều", "hl": ["very"]}, {"t": "Thank you very much.", "ph": "THENK YU VE-RI MÂCH", "vi": "Cảm ơn bạn rất nhiều.", "hl": ["very"], "tokens": ["Thank", "you", "very", "much"]}]}]},
{"id": 23, "vi": "quá", "note": "too + tính từ = quá ... (vượt mức, thường không tốt); so + tính từ = quá ... (cảm thán).", "pivot": {"t": "too", "ph": "TU"}, "branches": [{"steps": [{"t": "expensive", "ph": "IX-PEN-XÍP", "vi": "đắt", "hl": []}, {"t": "too expensive", "ph": "TU IX-PEN-XÍP", "vi": "quá đắt", "hl": ["too"]}, {"t": "This hotel is too expensive.", "ph": "ĐIS HÔU-TEL IZ TU IX-PEN-XÍP", "vi": "Khách sạn này đắt quá.", "hl": ["too"], "tokens": ["This", "hotel", "is", "too", "expensive"]}]}, {"steps": [{"t": "far", "ph": "PHA", "vi": "xa", "hl": []}, {"t": "too far", "ph": "TU PHA", "vi": "quá xa", "hl": ["too"]}, {"t": "It is too far to walk.", "ph": "IT IZ TU PHA TU UOK", "vi": "Xa quá, không đi bộ được.", "hl": ["too"], "tokens": ["It", "is", "too", "far", "to", "walk"]}]}, {"steps": [{"t": "spicy", "ph": "SPAI-XI", "vi": "cay", "hl": []}, {"t": "so spicy", "ph": "XÔU SPAI-XI", "vi": "cay quá", "hl": ["so"]}, {"t": "The noodles are so spicy.", "ph": "ĐƠ NU-ĐƠLZ A XÔU SPAI-XI", "vi": "Món mì cay quá.", "hl": ["so"], "tokens": ["The", "noodles", "are", "so", "spicy"]}]}]},
{"id": 24, "vi": "hơn", "note": "Tính từ ngắn + -er + than (cheaper than); tính từ dài: more + tính từ + than; good → better than.", "pivot": {"t": "than", "ph": "ĐEN"}, "branches": [{"steps": [{"t": "cheap", "ph": "CHÍP", "vi": "rẻ", "hl": []}, {"t": "cheaper than", "ph": "CHI-PƠ ĐEN", "vi": "rẻ hơn", "hl": ["cheaper than"]}, {"t": "The bus is cheaper than a taxi.", "ph": "ĐƠ BÁT IZ CHI-PƠ ĐEN Ơ TÉC-XI", "vi": "Xe buýt rẻ hơn taxi.", "hl": ["cheaper than"], "tokens": ["The", "bus", "is", "cheaper", "than", "a", "taxi"]}]}, {"steps": [{"t": "expensive", "ph": "IX-PEN-XÍP", "vi": "đắt", "hl": []}, {"t": "more expensive than", "ph": "MO IX-PEN-XÍP ĐEN", "vi": "đắt hơn", "hl": ["more", "than"]}, {"t": "This room is more expensive than that one.", "ph": "ĐIS RUM IZ MO IX-PEN-XÍP ĐEN ĐÉT UAN", "vi": "Phòng này đắt hơn phòng kia.", "hl": ["more", "than"], "tokens": ["This", "room", "is", "more", "expensive", "than", "that", "one"]}]}, {"steps": [{"t": "good", "ph": "GÚT", "vi": "tốt", "hl": []}, {"t": "better than", "ph": "BE-TƠ ĐEN", "vi": "tốt hơn", "hl": ["better than"]}, {"t": "Tea is better than coffee.", "ph": "TI IZ BE-TƠ ĐEN CO-PHI", "vi": "Trà tốt hơn cà phê.", "hl": ["better than"], "tokens": ["Tea", "is", "better", "than", "coffee"]}]}]},
{"id": 25, "vi": "nhất", "note": "the + tính từ ngắn + -est (the biggest); tính từ dài: the most + tính từ; good → the best.", "pivot": {"t": "the most / -est", "ph": "ĐƠ MÔUST / ÉST"}, "branches": [{"steps": [{"t": "big", "ph": "BÍC", "vi": "lớn", "hl": []}, {"t": "the biggest", "ph": "ĐƠ BÍ-GỊT", "vi": "lớn nhất", "hl": ["the biggest"]}, {"t": "This is the biggest city.", "ph": "ĐIS IZ ĐƠ BÍ-GỊT XI-TI", "vi": "Đây là thành phố lớn nhất.", "hl": ["the biggest"], "tokens": ["This", "is", "the", "biggest", "city"]}]}, {"steps": [{"t": "beautiful", "ph": "BIU-TI-PHƠL", "vi": "đẹp", "hl": []}, {"t": "the most beautiful", "ph": "ĐƠ MÔUST BIU-TI-PHƠL", "vi": "đẹp nhất", "hl": ["the most"]}, {"t": "It is the most beautiful beach.", "ph": "IT IZ ĐƠ MÔUST BIU-TI-PHƠL BICH", "vi": "Đó là bãi biển đẹp nhất.", "hl": ["the most"], "tokens": ["It", "is", "the", "most", "beautiful", "beach"]}]}, {"steps": [{"t": "good", "ph": "GÚT", "vi": "tốt", "hl": []}, {"t": "the best", "ph": "ĐƠ BÉST", "vi": "tốt nhất", "hl": ["the best"]}, {"t": "Where is the best restaurant?", "ph": "UE IZ ĐƠ BÉST RÉS-TƠ-RÔNT", "vi": "Nhà hàng ngon nhất ở đâu?", "hl": ["the best"], "tokens": ["Where", "is", "the", "best", "restaurant"]}]}]},
{"id": 26, "vi": "cũng", "note": "also đứng trước động từ thường và sau to be (I also speak, is also); too đứng cuối câu (I am hungry too).", "pivot": {"t": "also / too", "ph": "OL-XÔU / TU"}, "branches": [{"steps": [{"t": "hungry", "ph": "HĂNG-GRI", "vi": "đói", "hl": []}, {"t": "hungry too", "ph": "HĂNG-GRI TU", "vi": "cũng đói", "hl": ["too"]}, {"t": "I am hungry too.", "ph": "AI EM HĂNG-GRI TU", "vi": "Tôi cũng đói.", "hl": ["too"], "tokens": ["I", "am", "hungry", "too"]}]}, {"steps": [{"t": "speak", "ph": "SPIK", "vi": "nói", "hl": []}, {"t": "also speak", "ph": "OL-XÔU SPIK", "vi": "cũng nói", "hl": ["also"]}, {"t": "I also speak a little English.", "ph": "AI OL-XÔU SPIK Ơ LÍT-TƠL INH-GLISH", "vi": "Tôi cũng nói được một chút tiếng Anh.", "hl": ["also"], "tokens": ["I", "also", "speak", "a", "little", "English"]}]}, {"steps": [{"t": "teacher", "ph": "TI-CHƠ", "vi": "giáo viên", "hl": []}, {"t": "also a teacher", "ph": "OL-XÔU Ơ TI-CHƠ", "vi": "cũng là giáo viên", "hl": ["also"]}, {"t": "My wife is also a teacher.", "ph": "MAI UAIF IZ OL-XÔU Ơ TI-CHƠ", "vi": "Vợ tôi cũng là giáo viên.", "hl": ["also"], "tokens": ["My", "wife", "is", "also", "a", "teacher"]}]}]},
{"id": 27, "vi": "và", "note": "and nối hai từ, hai cụm hoặc hai hành động cùng loại: A and B.", "pivot": {"t": "and", "ph": "EN"}, "branches": [{"steps": [{"t": "soup", "ph": "XUP", "vi": "canh, súp", "hl": []}, {"t": "rice and soup", "ph": "RAIS EN XUP", "vi": "cơm và canh", "hl": ["and"]}, {"t": "We want rice and soup.", "ph": "UY UAN RAIS EN XUP", "vi": "Chúng tôi muốn cơm và canh.", "hl": ["and"], "tokens": ["We", "want", "rice", "and", "soup"]}]}, {"steps": [{"t": "brother", "ph": "BRA-ĐƠ", "vi": "anh/em trai", "hl": []}, {"t": "my brother and I", "ph": "MAI BRA-ĐƠ EN AI", "vi": "anh tôi và tôi", "hl": ["and"]}, {"t": "My brother and I are students.", "ph": "MAI BRA-ĐƠ EN AI A STIU-ĐƠNTS", "vi": "Anh tôi và tôi đều là sinh viên.", "hl": ["and"], "tokens": ["My", "brother", "and", "I", "are", "students"]}]}, {"steps": [{"t": "drank", "ph": "ĐRENK", "vi": "đã uống", "hl": []}, {"t": "ate and drank", "ph": "ÂYT EN ĐRENK", "vi": "ăn và uống", "hl": ["and"]}, {"t": "We ate and drank a lot.", "ph": "UY ÂYT EN ĐRENK Ơ LÓT", "vi": "Chúng tôi đã ăn uống rất nhiều.", "hl": ["and"], "tokens": ["We", "ate", "and", "drank", "a", "lot"]}]}]},
{"id": 28, "vi": "nhưng", "note": "but nối hai ý trái ngược nhau; khi nối hai mệnh đề dài thường có dấu phẩy trước but.", "pivot": {"t": "but", "ph": "BÁT"}, "branches": [{"steps": [{"t": "clean", "ph": "CLIN", "vi": "sạch", "hl": []}, {"t": "but clean", "ph": "BÁT CLIN", "vi": "nhưng sạch", "hl": ["but"]}, {"t": "The room is small but clean.", "ph": "ĐƠ RUM IZ XMÔL BÁT CLIN", "vi": "Phòng nhỏ nhưng sạch.", "hl": ["but"], "tokens": ["The", "room", "is", "small", "but", "clean"]}]}, {"steps": [{"t": "can't", "ph": "KÁNT", "vi": "không thể", "hl": []}, {"t": "but I can't", "ph": "BÁT AI KÁNT", "vi": "nhưng tôi không thể", "hl": ["but"]}, {"t": "I want to come but I can't.", "ph": "AI UAN TU CAM BÁT AI KÁNT", "vi": "Tôi muốn đến nhưng không được.", "hl": ["but"], "tokens": ["I", "want", "to", "come", "but", "I", "can't"]}]}, {"steps": [{"t": "little", "ph": "LÍT-TƠL", "vi": "một chút", "hl": []}, {"t": "but only a little", "ph": "BÁT ÔUN-LI Ơ LÍT-TƠL", "vi": "nhưng chỉ một chút", "hl": ["but"]}, {"t": "I speak English but only a little.", "ph": "AI SPIK INH-GLISH BÁT ÔUN-LI Ơ LÍT-TƠL", "vi": "Tôi nói tiếng Anh nhưng chỉ một chút.", "hl": ["but"], "tokens": ["I", "speak", "English", "but", "only", "a", "little"]}]}]},
{"id": 29, "vi": "nếu", "note": "If + thì hiện tại, (mệnh đề chính) will/mệnh lệnh: tiếng Anh không cần từ 'thì'. Đặt mệnh đề if ở cuối thì không cần dấu phẩy.", "pivot": {"t": "if", "ph": "IF"}, "branches": [{"steps": [{"t": "need", "ph": "NIT", "vi": "cần", "hl": []}, {"t": "if you need", "ph": "IF YU NIT", "vi": "nếu bạn cần", "hl": ["if"]}, {"t": "Call me if you need help.", "ph": "CÔL MI IF YU NIT HEL-P", "vi": "Nếu cần giúp thì gọi tôi nhé.", "hl": ["if"], "tokens": ["Call", "me", "if", "you", "need", "help"]}]}, {"steps": [{"t": "rains", "ph": "RÂYNZ", "vi": "mưa", "hl": []}, {"t": "if it rains", "ph": "IF IT RÂYNZ", "vi": "nếu trời mưa", "hl": ["if"]}, {"t": "We will stay home if it rains.", "ph": "UY UYL STÂY HÔUM IF IT RÂYNZ", "vi": "Nếu trời mưa thì chúng tôi sẽ ở nhà.", "hl": ["will", "if"], "tokens": ["We", "will", "stay", "home", "if", "it", "rains"]}]}, {"steps": [{"t": "time", "ph": "TAIM", "vi": "thời gian", "hl": []}, {"t": "if you have time", "ph": "IF YU HEV TAIM", "vi": "nếu bạn có thời gian", "hl": ["if"]}, {"t": "Come with us if you have time.", "ph": "CAM UYĐ ÁT IF YU HEV TAIM", "vi": "Nếu có thời gian thì đi cùng chúng tôi nhé.", "hl": ["if"], "tokens": ["Come", "with", "us", "if", "you", "have", "time"]}]}]},
{"id": 30, "vi": "này / kia", "note": "this (số ít) / these (số nhiều) = này, ở gần; that / those = kia, ở xa. Dùng that one / this one để thay cho danh từ.", "pivot": {"t": "this / that", "ph": "ĐIS / ĐÉT"}, "branches": [{"steps": [{"t": "bag", "ph": "BÉC", "vi": "túi", "hl": []}, {"t": "this bag", "ph": "ĐIS BÉC", "vi": "cái túi này", "hl": ["this"]}, {"t": "How much is this bag?", "ph": "HAO MÂCH IZ ĐIS BÉC", "vi": "Cái túi này bao nhiêu tiền?", "hl": ["this"], "tokens": ["How", "much", "is", "this", "bag"]}]}, {"steps": [{"t": "one", "ph": "UAN", "vi": "cái", "hl": []}, {"t": "that one", "ph": "ĐÉT UAN", "vi": "cái kia", "hl": ["that"]}, {"t": "I'd like that one.", "ph": "AIĐ LAIK ĐÉT UAN", "vi": "Tôi muốn cái kia.", "hl": ["that"], "tokens": ["I'd", "like", "that", "one"]}]}, {"steps": [{"t": "seats", "ph": "XÍTS", "vi": "ghế ngồi", "hl": []}, {"t": "those seats", "ph": "ĐÔUZ XÍTS", "vi": "mấy ghế kia", "hl": ["those"]}, {"t": "Are those seats free?", "ph": "A ĐÔUZ XÍTS PHRI", "vi": "Mấy ghế kia còn trống không?", "hl": ["those"], "tokens": ["Are", "those", "seats", "free"]}]}]},
{"id": 31, "vi": "của", "note": "Dùng tính từ sở hữu (my, your, his, her...) trước danh từ, thêm 's sau tên người (Lan's phone), hoặc dùng of cho đồ vật (the name of the hotel).", "pivot": {"t": "my / 's / of", "ph": "MAI / X / ÓV"}, "branches": [{"steps": [{"t": "passport", "ph": "PÁT-SPOT", "vi": "hộ chiếu", "hl": []}, {"t": "my passport", "ph": "MAI PÁT-SPOT", "vi": "hộ chiếu của tôi", "hl": ["my"]}, {"t": "I lost my passport.", "ph": "AI LÓST MAI PÁT-SPOT", "vi": "Tôi bị mất hộ chiếu.", "hl": ["my"], "tokens": ["I", "lost", "my", "passport"]}]}, {"steps": [{"t": "phone", "ph": "PHÔUN", "vi": "điện thoại", "hl": []}, {"t": "Lan's phone", "ph": "LANZ PHÔUN", "vi": "điện thoại của Lan", "hl": ["'s"]}, {"t": "This is Lan's phone.", "ph": "ĐIS IZ LANZ PHÔUN", "vi": "Đây là điện thoại của Lan.", "hl": ["'s"], "tokens": ["This", "is", "Lan's", "phone"]}]}, {"steps": [{"t": "hotel", "ph": "HÔU-TEL", "vi": "khách sạn", "hl": []}, {"t": "name of the hotel", "ph": "NEIM ÓV ĐƠ HÔU-TEL", "vi": "tên của khách sạn", "hl": ["of"]}, {"t": "What is the name of the hotel?", "ph": "UÓT IZ ĐƠ NEIM ÓV ĐƠ HÔU-TEL", "vi": "Tên của khách sạn là gì?", "hl": ["of"], "tokens": ["What", "is", "the", "name", "of", "the", "hotel"]}]}]},
{"id": 32, "vi": "ở / tại", "note": "at + địa điểm cụ thể (at the hotel); in + thành phố, quốc gia, không gian kín (in Hanoi); on + bề mặt (on the table).", "pivot": {"t": "at / in", "ph": "ÉT / IN"}, "branches": [{"steps": [{"t": "hotel", "ph": "HÔU-TEL", "vi": "khách sạn", "hl": []}, {"t": "at the hotel", "ph": "ÉT ĐƠ HÔU-TEL", "vi": "ở khách sạn", "hl": ["at"]}, {"t": "Let's meet at the hotel.", "ph": "LÉTS MIT ÉT ĐƠ HÔU-TEL", "vi": "Mình gặp nhau ở khách sạn nhé.", "hl": ["at"], "tokens": ["Let's", "meet", "at", "the", "hotel"]}]}, {"steps": [{"t": "Hanoi", "ph": "HA-NOI", "vi": "Hà Nội", "hl": []}, {"t": "in Hanoi", "ph": "IN HA-NOI", "vi": "ở Hà Nội", "hl": ["in"]}, {"t": "My family lives in Hanoi.", "ph": "MAI PHE-MI-LI LIVZ IN HA-NOI", "vi": "Gia đình tôi sống ở Hà Nội.", "hl": ["in"], "tokens": ["My", "family", "lives", "in", "Hanoi"]}]}, {"steps": [{"t": "table", "ph": "TÂY-BƠL", "vi": "cái bàn", "hl": []}, {"t": "on the table", "ph": "ON ĐƠ TÂY-BƠL", "vi": "ở trên bàn", "hl": ["on"]}, {"t": "Your keys are on the table.", "ph": "DO KIZ A ON ĐƠ TÂY-BƠL", "vi": "Chìa khóa của bạn ở trên bàn.", "hl": ["on"], "tokens": ["Your", "keys", "are", "on", "the", "table"]}]}]},
{"id": 33, "vi": "với", "note": "with + người = cùng với ai; with + vật = có kèm theo cái gì (coffee with milk).", "pivot": {"t": "with", "ph": "UYĐ"}, "branches": [{"steps": [{"t": "me", "ph": "MI", "vi": "tôi", "hl": []}, {"t": "with me", "ph": "UYĐ MI", "vi": "với tôi", "hl": ["with"]}, {"t": "Can you come with me?", "ph": "KEN YU CAM UYĐ MI", "vi": "Bạn đi cùng tôi được không?", "hl": ["with"], "tokens": ["Can", "you", "come", "with", "me"]}]}, {"steps": [{"t": "friends", "ph": "PHRENĐZ", "vi": "bạn bè", "hl": []}, {"t": "with friends", "ph": "UYĐ PHRENĐZ", "vi": "với bạn bè", "hl": ["with"]}, {"t": "I travel with friends.", "ph": "AI TRE-VƠL UYĐ PHRENĐZ", "vi": "Tôi đi du lịch với bạn bè.", "hl": ["with"], "tokens": ["I", "travel", "with", "friends"]}]}, {"steps": [{"t": "milk", "ph": "MILK", "vi": "sữa", "hl": []}, {"t": "with milk", "ph": "UYĐ MILK", "vi": "với sữa", "hl": ["with"]}, {"t": "I'd like coffee with milk.", "ph": "AIĐ LAIK CO-PHI UYĐ MILK", "vi": "Tôi muốn cà phê sữa.", "hl": ["with"], "tokens": ["I'd", "like", "coffee", "with", "milk"]}]}]},
{"id": 34, "vi": "cho", "note": "give + người + vật = đưa cho ai cái gì; for + người/số lượng = cho ai, dành cho ai (a gift for you, a table for two).", "pivot": {"t": "give / for", "ph": "GIV / PHO"}, "branches": [{"steps": [{"t": "me", "ph": "MI", "vi": "tôi", "hl": []}, {"t": "give me", "ph": "GIV MI", "vi": "đưa cho tôi", "hl": ["give"]}, {"t": "Can you give me the menu?", "ph": "KEN YU GIV MI ĐƠ ME-NIU", "vi": "Bạn đưa cho tôi thực đơn được không?", "hl": ["give"], "tokens": ["Can", "you", "give", "me", "the", "menu"]}]}, {"steps": [{"t": "you", "ph": "YU", "vi": "bạn", "hl": []}, {"t": "for you", "ph": "PHO YU", "vi": "cho bạn", "hl": ["for"]}, {"t": "This gift is for you.", "ph": "ĐIS GIPHT IZ PHO YU", "vi": "Món quà này là dành cho bạn.", "hl": ["for"], "tokens": ["This", "gift", "is", "for", "you"]}]}, {"steps": [{"t": "two", "ph": "TU", "vi": "hai", "hl": []}, {"t": "a table for two", "ph": "Ơ TÂY-BƠL PHO TU", "vi": "bàn cho hai người", "hl": ["for"]}, {"t": "We need a table for two.", "ph": "UY NIT Ơ TÂY-BƠL PHO TU", "vi": "Chúng tôi cần một bàn cho hai người.", "hl": ["for"], "tokens": ["We", "need", "a", "table", "for", "two"]}]}]},
{"id": 35, "vi": "phải", "note": "have to / has to + động từ nguyên mẫu = phải làm gì (do hoàn cảnh); must + động từ nguyên mẫu = phải (quy định, bắt buộc mạnh).", "pivot": {"t": "must / have to", "ph": "MÁST / HEV TU"}, "branches": [{"steps": [{"t": "go", "ph": "GÔU", "vi": "đi", "hl": []}, {"t": "have to go", "ph": "HEV TU GÔU", "vi": "phải đi", "hl": ["have to"]}, {"t": "I have to go now.", "ph": "AI HEV TU GÔU NAO", "vi": "Tôi phải đi bây giờ.", "hl": ["have to"], "tokens": ["I", "have", "to", "go", "now"]}]}, {"steps": [{"t": "wear", "ph": "UE", "vi": "đội, mặc", "hl": []}, {"t": "must wear", "ph": "MÁST UE", "vi": "phải đội", "hl": ["must"]}, {"t": "You must wear a helmet.", "ph": "YU MÁST UE Ơ HEL-MỊT", "vi": "Bạn phải đội mũ bảo hiểm.", "hl": ["must"], "tokens": ["You", "must", "wear", "a", "helmet"]}]}, {"steps": [{"t": "work", "ph": "UƠK", "vi": "làm việc", "hl": []}, {"t": "has to work", "ph": "HEZ TU UƠK", "vi": "phải làm việc", "hl": ["has to"]}, {"t": "She has to work today.", "ph": "SHI HEZ TU UƠK TU-ĐÂY", "vi": "Hôm nay cô ấy phải đi làm.", "hl": ["has to"], "tokens": ["She", "has", "to", "work", "today"]}]}]},
{"id": 36, "vi": "thử", "note": "try + danh từ = thử món/đồ gì; try ... on = thử (quần áo); try to + động từ = cố gắng làm gì.", "pivot": {"t": "try", "ph": "TRAI"}, "branches": [{"steps": [{"t": "dish", "ph": "ĐISH", "vi": "món ăn", "hl": []}, {"t": "try this dish", "ph": "TRAI ĐIS ĐISH", "vi": "thử món này", "hl": ["try"]}, {"t": "You should try this dish.", "ph": "YU SHÚD TRAI ĐIS ĐISH", "vi": "Bạn nên thử món này.", "hl": ["try"], "tokens": ["You", "should", "try", "this", "dish"]}]}, {"steps": [{"t": "shirt", "ph": "SHƠT", "vi": "áo sơ mi", "hl": []}, {"t": "try this shirt on", "ph": "TRAI ĐIS SHƠT ON", "vi": "mặc thử áo này", "hl": ["try", "on"]}, {"t": "Can I try this shirt on?", "ph": "KEN AI TRAI ĐIS SHƠT ON", "vi": "Tôi mặc thử áo này được không?", "hl": ["try", "on"], "tokens": ["Can", "I", "try", "this", "shirt", "on"]}]}, {"steps": [{"t": "speak", "ph": "SPIK", "vi": "nói", "hl": []}, {"t": "try to speak", "ph": "TRAI TU SPIK", "vi": "cố gắng nói", "hl": ["try to"]}, {"t": "I try to speak English every day.", "ph": "AI TRAI TU SPIK INH-GLISH E-VRI ĐÂY", "vi": "Tôi cố gắng nói tiếng Anh mỗi ngày.", "hl": ["try to"], "tokens": ["I", "try", "to", "speak", "English", "every", "day"]}]}]}
]
