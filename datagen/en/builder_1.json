[
{"id": 1, "vi": "không", "note": "Dùng don't (I/you/we/they) hoặc doesn't (he/she/it) + động từ nguyên mẫu để phủ định; với to be (am/is/are) thì chỉ cần thêm not.", "pivot": {"t": "don't", "ph": "DOUNT"}, "branches": [{"steps": [{"t": "speak", "ph": "SPIK", "vi": "nói", "hl": []}, {"t": "don't speak", "ph": "DOUNT SPIK", "vi": "không nói", "hl": ["don't"]}, {"t": "I don't speak French.", "ph": "AI DOUNT SPIK FRENCH", "vi": "Tôi không nói tiếng Pháp.", "hl": ["don't"], "tokens": ["I", "don't", "speak", "French"]}]}, {"steps": [{"t": "eat", "ph": "IT", "vi": "ăn", "hl": []}, {"t": "don't eat", "ph": "DOUNT IT", "vi": "không ăn", "hl": ["don't"]}, {"t": "I don't eat meat.", "ph": "AI DOUNT IT MIT", "vi": "Tôi không ăn thịt.", "hl": ["don't"], "tokens": ["I", "don't", "eat", "meat"]}]}, {"steps": [{"t": "work", "ph": "UƠK", "vi": "hoạt động", "hl": []}, {"t": "doesn't work", "ph": "ĐA-DƠNT UƠK", "vi": "không hoạt động", "hl": ["doesn't"]}, {"t": "The wifi doesn't work.", "ph": "ĐƠ UAI-PHAI ĐA-DƠNT UƠK", "vi": "Wifi không hoạt động.", "hl": ["doesn't"], "tokens": ["The", "wifi", "doesn't", "work"]}]}]},
{"id": 2, "vi": "có", "note": "Dùng have (I/you/we/they) hoặc has (he/she/it) + danh từ để nói ai đó có cái gì; câu hỏi dùng Do you have ...?", "pivot": {"t": "have", "ph": "HEV"}, "branches": [{"steps": [{"t": "ticket", "ph": "TI-KỊT", "vi": "vé", "hl": []}, {"t": "have a ticket", "ph": "HEV Ơ TI-KỊT", "vi": "có vé", "hl": ["have"]}, {"t": "I have a ticket.", "ph": "AI HEV Ơ TI-KỊT", "vi": "Tôi có vé.", "hl": ["have"], "tokens": ["I", "have", "a", "ticket"]}]}, {"steps": [{"t": "map", "ph": "MEP", "vi": "bản đồ", "hl": []}, {"t": "have a map", "ph": "HEV Ơ MEP", "vi": "có bản đồ", "hl": ["have"]}, {"t": "Do you have a map?", "ph": "DU YU HEV Ơ MEP", "vi": "Bạn có bản đồ không?", "hl": ["have"], "tokens": ["Do", "you", "have", "a", "map"]}]}, {"steps": [{"t": "pool", "ph": "PUL", "vi": "hồ bơi", "hl": []}, {"t": "has a pool", "ph": "HEZ Ơ PUL", "vi": "có hồ bơi", "hl": ["has"]}, {"t": "The hotel has a pool.", "ph": "ĐƠ HÔU-TEL HEZ Ơ PUL", "vi": "Khách sạn có hồ bơi.", "hl": ["has"], "tokens": ["The", "hotel", "has", "a", "pool"]}]}]},
{"id": 3, "vi": "là", "note": "Dùng động từ to be: I am, you/we/they are, he/she/it is, theo sau là danh từ hoặc tính từ để giới thiệu hay định nghĩa.", "pivot": {"t": "is", "ph": "IZ"}, "branches": [{"steps": [{"t": "student", "ph": "STIU-ĐƠNT", "vi": "học sinh, sinh viên", "hl": []}, {"t": "am a student", "ph": "EM Ơ STIU-ĐƠNT", "vi": "là sinh viên", "hl": ["am"]}, {"t": "I am a student.", "ph": "AI EM Ơ STIU-ĐƠNT", "vi": "Tôi là sinh viên.", "hl": ["am"], "tokens": ["I", "am", "a", "student"]}]}, {"steps": [{"t": "name", "ph": "NEIM", "vi": "tên", "hl": []}, {"t": "name is", "ph": "NEIM IZ", "vi": "tên là", "hl": ["is"]}, {"t": "My name is Lan.", "ph": "MAI NEIM IZ LAN", "vi": "Tên tôi là Lan.", "hl": ["is"], "tokens": ["My", "name", "is", "Lan"]}]}, {"steps": [{"t": "friends", "ph": "PHRENĐZ", "vi": "bạn bè", "hl": []}, {"t": "are friends", "ph": "A PHRENĐZ", "vi": "là bạn bè", "hl": ["are"]}, {"t": "We are friends now.", "ph": "UY A PHRENĐZ NAO", "vi": "Giờ chúng ta là bạn rồi.", "hl": ["are"], "tokens": ["We", "are", "friends", "now"]}]}]},
{"id": 4, "vi": "muốn", "note": "want + danh từ = muốn cái gì; want to + động từ nguyên mẫu = muốn làm gì.", "pivot": {"t": "want", "ph": "UAN"}, "branches": [{"steps": [{"t": "coffee", "ph": "CO-PHI", "vi": "cà phê", "hl": []}, {"t": "want coffee", "ph": "UAN CO-PHI", "vi": "muốn cà phê", "hl": ["want"]}, {"t": "I want coffee and bread.", "ph": "AI UAN CO-PHI EN BRET", "vi": "Tôi muốn cà phê và bánh mì.", "hl": ["want"], "tokens": ["I", "want", "coffee", "and", "bread"]}]}, {"steps": [{"t": "go", "ph": "GÔU", "vi": "đi", "hl": []}, {"t": "want to go", "ph": "UAN TU GÔU", "vi": "muốn đi", "hl": ["want to"]}, {"t": "I want to go home.", "ph": "AI UAN TU GÔU HÔUM", "vi": "Tôi muốn về nhà.", "hl": ["want to"], "tokens": ["I", "want", "to", "go", "home"]}]}, {"steps": [{"t": "buy", "ph": "BAI", "vi": "mua", "hl": []}, {"t": "want to buy", "ph": "UAN TU BAI", "vi": "muốn mua", "hl": ["want to"]}, {"t": "Do you want to buy this?", "ph": "DU YU UAN TU BAI ĐIS", "vi": "Bạn có muốn mua cái này không?", "hl": ["want to"], "tokens": ["Do", "you", "want", "to", "buy", "this"]}]}]},
{"id": 5, "vi": "thích", "note": "like + danh từ = thích cái gì; like + V-ing = thích làm gì. Với he/she/it dùng likes.", "pivot": {"t": "like", "ph": "LAIK"}, "branches": [{"steps": [{"t": "music", "ph": "MIU-DÍCH", "vi": "âm nhạc", "hl": []}, {"t": "like music", "ph": "LAIK MIU-DÍCH", "vi": "thích âm nhạc", "hl": ["like"]}, {"t": "I like music very much.", "ph": "AI LAIK MIU-DÍCH VE-RI MÂCH", "vi": "Tôi rất thích âm nhạc.", "hl": ["like"], "tokens": ["I", "like", "music", "very", "much"]}]}, {"steps": [{"t": "swimming", "ph": "XUY-MINH", "vi": "bơi lội", "hl": []}, {"t": "like swimming", "ph": "LAIK XUY-MINH", "vi": "thích bơi", "hl": ["like"]}, {"t": "I like swimming in the sea.", "ph": "AI LAIK XUY-MINH IN ĐƠ XI", "vi": "Tôi thích bơi ở biển.", "hl": ["like"], "tokens": ["I", "like", "swimming", "in", "the", "sea"]}]}, {"steps": [{"t": "cats", "ph": "KÉTS", "vi": "mèo", "hl": []}, {"t": "likes cats", "ph": "LAIKS KÉTS", "vi": "thích mèo", "hl": ["likes"]}, {"t": "My sister likes cats.", "ph": "MAI XÍT-TƠ LAIKS KÉTS", "vi": "Em gái tôi thích mèo.", "hl": ["likes"], "tokens": ["My", "sister", "likes", "cats"]}]}]},
{"id": 6, "vi": "cần", "note": "need + danh từ = cần cái gì; need to + động từ nguyên mẫu = cần làm gì.", "pivot": {"t": "need", "ph": "NIT"}, "branches": [{"steps": [{"t": "help", "ph": "HEL-P", "vi": "sự giúp đỡ", "hl": []}, {"t": "need help", "ph": "NIT HEL-P", "vi": "cần giúp", "hl": ["need"]}, {"t": "Do you need help?", "ph": "DU YU NIT HEL-P", "vi": "Bạn có cần giúp không?", "hl": ["need"], "tokens": ["Do", "you", "need", "help"]}]}, {"steps": [{"t": "taxi", "ph": "TÉC-XI", "vi": "taxi", "hl": []}, {"t": "need a taxi", "ph": "NIT Ơ TÉC-XI", "vi": "cần một chiếc taxi", "hl": ["need"]}, {"t": "We need a taxi.", "ph": "UY NIT Ơ TÉC-XI", "vi": "Chúng tôi cần một chiếc taxi.", "hl": ["need"], "tokens": ["We", "need", "a", "taxi"]}]}, {"steps": [{"t": "change", "ph": "CHEINJ", "vi": "đổi", "hl": []}, {"t": "need to change", "ph": "NIT TU CHEINJ", "vi": "cần đổi", "hl": ["need to"]}, {"t": "I need to change money.", "ph": "AI NIT TU CHEINJ MA-NI", "vi": "Tôi cần đổi tiền.", "hl": ["need to"], "tokens": ["I", "need", "to", "change", "money"]}]}]},
{"id": 7, "vi": "có thể", "note": "can + động từ nguyên mẫu để nói khả năng (có thể làm gì); phủ định là can't. Câu hỏi Can I/you ...? dùng để xin phép hoặc nhờ.", "pivot": {"t": "can", "ph": "KEN"}, "branches": [{"steps": [{"t": "speak", "ph": "SPIK", "vi": "nói", "hl": []}, {"t": "can speak", "ph": "KEN SPIK", "vi": "có thể nói", "hl": ["can"]}, {"t": "She can speak English.", "ph": "SHI KEN SPIK INH-GLISH", "vi": "Cô ấy nói được tiếng Anh.", "hl": ["can"], "tokens": ["She", "can", "speak", "English"]}]}, {"steps": [{"t": "pay", "ph": "PÂY", "vi": "trả tiền", "hl": []}, {"t": "can pay", "ph": "KEN PÂY", "vi": "có thể trả tiền", "hl": ["can"]}, {"t": "I can pay by card.", "ph": "AI KEN PÂY BAI CA-ĐƠ", "vi": "Tôi có thể trả bằng thẻ.", "hl": ["can"], "tokens": ["I", "can", "pay", "by", "card"]}]}, {"steps": [{"t": "find", "ph": "PHAIN", "vi": "tìm thấy", "hl": []}, {"t": "can't find", "ph": "KÁNT PHAIN", "vi": "không tìm thấy", "hl": ["can't"]}, {"t": "I can't find my phone.", "ph": "AI KÁNT PHAIN MAI PHÔUN", "vi": "Tôi không tìm thấy điện thoại.", "hl": ["can't"], "tokens": ["I", "can't", "find", "my", "phone"]}]}]},
{"id": 8, "vi": "đi", "note": "go to + nơi chốn = đi đến đâu; go by + phương tiện = đi bằng gì; go + V-ing = đi làm hoạt động gì (go shopping).", "pivot": {"t": "go", "ph": "GÔU"}, "branches": [{"steps": [{"t": "beach", "ph": "BICH", "vi": "bãi biển", "hl": []}, {"t": "go to the beach", "ph": "GÔU TU ĐƠ BICH", "vi": "đi biển", "hl": ["go to"]}, {"t": "Let's go to the beach.", "ph": "LÉTS GÔU TU ĐƠ BICH", "vi": "Mình đi biển đi.", "hl": ["go to"], "tokens": ["Let's", "go", "to", "the", "beach"]}]}, {"steps": [{"t": "bus", "ph": "BÁT", "vi": "xe buýt", "hl": []}, {"t": "go by bus", "ph": "GÔU BAI BÁT", "vi": "đi bằng xe buýt", "hl": ["go by"]}, {"t": "We can go by bus.", "ph": "UY KEN GÔU BAI BÁT", "vi": "Chúng ta có thể đi bằng xe buýt.", "hl": ["go by"], "tokens": ["We", "can", "go", "by", "bus"]}]}, {"steps": [{"t": "shopping", "ph": "SHÓP-PINH", "vi": "mua sắm", "hl": []}, {"t": "go shopping", "ph": "GÔU SHÓP-PINH", "vi": "đi mua sắm", "hl": ["go"]}, {"t": "We go shopping on Sunday.", "ph": "UY GÔU SHÓP-PINH ON XAN-ĐÂY", "vi": "Chúng tôi đi mua sắm vào Chủ nhật.", "hl": ["go"], "tokens": ["We", "go", "shopping", "on", "Sunday"]}]}]},
{"id": 9, "vi": "ở đâu", "note": "Where is + danh từ số ít? / Where are + danh từ số nhiều? để hỏi vị trí. Trong câu hỏi gián tiếp, động từ đứng sau: where the station is.", "pivot": {"t": "where", "ph": "UE"}, "branches": [{"steps": [{"t": "toilet", "ph": "TOI-LƠT", "vi": "nhà vệ sinh", "hl": []}, {"t": "where is the toilet", "ph": "UE IZ ĐƠ TOI-LƠT", "vi": "nhà vệ sinh ở đâu", "hl": ["where", "is"]}, {"t": "Where is the toilet on this floor?", "ph": "UE IZ ĐƠ TOI-LƠT ON ĐIS PHLO", "vi": "Nhà vệ sinh ở tầng này ở đâu?", "hl": ["Where", "is"], "tokens": ["Where", "is", "the", "toilet", "on", "this", "floor"]}]}, {"steps": [{"t": "station", "ph": "STÂY-SHƠN", "vi": "nhà ga", "hl": []}, {"t": "where the station is", "ph": "UE ĐƠ STÂY-SHƠN IZ", "vi": "nhà ga ở đâu", "hl": ["where"]}, {"t": "Do you know where the station is?", "ph": "DU YU NÂU UE ĐƠ STÂY-SHƠN IZ", "vi": "Bạn có biết nhà ga ở đâu không?", "hl": ["where"], "tokens": ["Do", "you", "know", "where", "the", "station", "is"]}]}, {"steps": [{"t": "staying", "ph": "STÂY-INH", "vi": "ở, lưu trú", "hl": []}, {"t": "where are you staying", "ph": "UE A YU STÂY-INH", "vi": "bạn ở đâu", "hl": ["where", "are"]}, {"t": "Where are you staying tonight?", "ph": "UE A YU STÂY-INH TU-NAIT", "vi": "Tối nay bạn ở đâu?", "hl": ["Where", "are"], "tokens": ["Where", "are", "you", "staying", "tonight"]}]}]},
{"id": 10, "vi": "bao nhiêu", "note": "How much ...? để hỏi giá hoặc danh từ không đếm được; How many + danh từ số nhiều? để hỏi số lượng đếm được.", "pivot": {"t": "how much", "ph": "HAO MÂCH"}, "branches": [{"steps": [{"t": "this", "ph": "ĐIS", "vi": "cái này", "hl": []}, {"t": "how much is this", "ph": "HAO MÂCH IZ ĐIS", "vi": "cái này bao nhiêu", "hl": ["how much"]}, {"t": "How much is this shirt?", "ph": "HAO MÂCH IZ ĐIS SHƠT", "vi": "Cái áo này bao nhiêu tiền?", "hl": ["How much"], "tokens": ["How", "much", "is", "this", "shirt"]}]}, {"steps": [{"t": "days", "ph": "ĐÂYZ", "vi": "ngày", "hl": []}, {"t": "how many days", "ph": "HAO ME-NI ĐÂYZ", "vi": "bao nhiêu ngày", "hl": ["how many"]}, {"t": "How many days will you stay?", "ph": "HAO ME-NI ĐÂYZ UYL YU STÂY", "vi": "Bạn sẽ ở lại bao nhiêu ngày?", "hl": ["How many"], "tokens": ["How", "many", "days", "will", "you", "stay"]}]}, {"steps": [{"t": "money", "ph": "MA-NI", "vi": "tiền", "hl": []}, {"t": "how much money", "ph": "HAO MÂCH MA-NI", "vi": "bao nhiêu tiền", "hl": ["how much"]}, {"t": "How much money do you need?", "ph": "HAO MÂCH MA-NI DU YU NIT", "vi": "Bạn cần bao nhiêu tiền?", "hl": ["How much"], "tokens": ["How", "much", "money", "do", "you", "need"]}]}]},
{"id": 11, "vi": "cái gì", "note": "What + trợ động từ (is/do/does) + chủ ngữ ...? để hỏi cái gì, làm gì; what to + động từ = (biết) làm gì.", "pivot": {"t": "what", "ph": "UÓT"}, "branches": [{"steps": [{"t": "this", "ph": "ĐIS", "vi": "cái này", "hl": []}, {"t": "what is this", "ph": "UÓT IZ ĐIS", "vi": "đây là cái gì", "hl": ["what"]}, {"t": "What is this in English?", "ph": "UÓT IZ ĐIS IN INH-GLISH", "vi": "Cái này tiếng Anh là gì?", "hl": ["What"], "tokens": ["What", "is", "this", "in", "English"]}]}, {"steps": [{"t": "want", "ph": "UAN", "vi": "muốn", "hl": []}, {"t": "what do you want", "ph": "UÓT DU YU UAN", "vi": "bạn muốn gì", "hl": ["what"]}, {"t": "What do you want to eat?", "ph": "UÓT DU YU UAN TU IT", "vi": "Bạn muốn ăn gì?", "hl": ["What"], "tokens": ["What", "do", "you", "want", "to", "eat"]}]}, {"steps": [{"t": "do", "ph": "DU", "vi": "làm", "hl": []}, {"t": "what to do", "ph": "UÓT TU DU", "vi": "làm gì", "hl": ["what"]}, {"t": "I don't know what to do.", "ph": "AI DOUNT NÂU UÓT TU DU", "vi": "Tôi không biết phải làm gì.", "hl": ["what"], "tokens": ["I", "don't", "know", "what", "to", "do"]}]}]},
{"id": 12, "vi": "ai", "note": "Who + động từ ...? để hỏi ai làm gì (động từ chia ngôi thứ ba: who speaks); Who is ...? để hỏi là ai.", "pivot": {"t": "who", "ph": "HU"}, "branches": [{"steps": [{"t": "that", "ph": "ĐÉT", "vi": "đó, kia", "hl": []}, {"t": "who is that", "ph": "HU IZ ĐÉT", "vi": "đó là ai", "hl": ["who"]}, {"t": "Who is that man?", "ph": "HU IZ ĐÉT MEN", "vi": "Người đàn ông kia là ai?", "hl": ["Who"], "tokens": ["Who", "is", "that", "man"]}]}, {"steps": [{"t": "speaks", "ph": "SPIKS", "vi": "nói", "hl": []}, {"t": "who speaks", "ph": "HU SPIKS", "vi": "ai nói", "hl": ["who"]}, {"t": "Who speaks English here?", "ph": "HU SPIKS INH-GLISH HIA", "vi": "Ở đây ai nói tiếng Anh?", "hl": ["Who"], "tokens": ["Who", "speaks", "English", "here"]}]}, {"steps": [{"t": "called", "ph": "CÔLĐ", "vi": "đã gọi", "hl": []}, {"t": "who called", "ph": "HU CÔLĐ", "vi": "ai đã gọi", "hl": ["who"]}, {"t": "Do you know who called me?", "ph": "DU YU NÂU HU CÔLĐ MI", "vi": "Bạn có biết ai đã gọi cho tôi không?", "hl": ["who"], "tokens": ["Do", "you", "know", "who", "called", "me"]}]}]},
{"id": 13, "vi": "khi nào", "note": "When + trợ động từ + chủ ngữ + động từ? để hỏi khi nào; What time ...? để hỏi mấy giờ. Đứng giữa câu, when nghĩa là 'khi'.", "pivot": {"t": "when", "ph": "UEN"}, "branches": [{"steps": [{"t": "leave", "ph": "LIV", "vi": "rời đi", "hl": []}, {"t": "when do we leave", "ph": "UEN DU UY LIV", "vi": "khi nào chúng ta đi", "hl": ["when"]}, {"t": "When do we leave tomorrow?", "ph": "UEN DU UY LIV TU-MO-RÔU", "vi": "Ngày mai khi nào chúng ta đi?", "hl": ["When"], "tokens": ["When", "do", "we", "leave", "tomorrow"]}]}, {"steps": [{"t": "time", "ph": "TAIM", "vi": "giờ", "hl": []}, {"t": "what time", "ph": "UÓT TAIM", "vi": "mấy giờ", "hl": ["what time"]}, {"t": "What time does the shop open?", "ph": "UÓT TAIM DÁT ĐƠ SHÓP ÔU-PƠN", "vi": "Cửa hàng mở cửa lúc mấy giờ?", "hl": ["What time"], "tokens": ["What", "time", "does", "the", "shop", "open"]}]}, {"steps": [{"t": "arrive", "ph": "Ơ-RAIV", "vi": "đến nơi", "hl": []}, {"t": "when you arrive", "ph": "UEN YU Ơ-RAIV", "vi": "khi bạn đến", "hl": ["when"]}, {"t": "Call me when you arrive.", "ph": "CÔL MI UEN YU Ơ-RAIV", "vi": "Gọi cho tôi khi bạn đến nhé.", "hl": ["when"], "tokens": ["Call", "me", "when", "you", "arrive"]}]}]},
{"id": 14, "vi": "tại sao / vì", "note": "Why + trợ động từ + chủ ngữ ...? để hỏi lý do; trả lời bằng because + mệnh đề, hoặc because of + danh từ.", "pivot": {"t": "why / because", "ph": "UAI / BI-CÔZ"}, "branches": [{"steps": [{"t": "late", "ph": "LÂYT", "vi": "muộn", "hl": []}, {"t": "why are you late", "ph": "UAI A YU LÂYT", "vi": "sao bạn đến muộn", "hl": ["why"]}, {"t": "Why are you late today?", "ph": "UAI A YU LÂYT TU-ĐÂY", "vi": "Sao hôm nay bạn đến muộn?", "hl": ["Why"], "tokens": ["Why", "are", "you", "late", "today"]}]}, {"steps": [{"t": "tired", "ph": "TAI-ƠĐ", "vi": "mệt", "hl": []}, {"t": "because I'm tired", "ph": "BI-CÔZ AIM TAI-ƠĐ", "vi": "vì tôi mệt", "hl": ["because"]}, {"t": "I want to sleep because I'm tired.", "ph": "AI UAN TU SLIP BI-CÔZ AIM TAI-ƠĐ", "vi": "Tôi muốn ngủ vì tôi mệt.", "hl": ["because"], "tokens": ["I", "want", "to", "sleep", "because", "I'm", "tired"]}]}, {"steps": [{"t": "rain", "ph": "RÂYN", "vi": "mưa", "hl": []}, {"t": "because of the rain", "ph": "BI-CÔZ ÓV ĐƠ RÂYN", "vi": "vì trời mưa", "hl": ["because of"]}, {"t": "The flight is late because of the rain.", "ph": "ĐƠ PHLAIT IZ LÂYT BI-CÔZ ÓV ĐƠ RÂYN", "vi": "Chuyến bay bị trễ vì trời mưa.", "hl": ["because of"], "tokens": ["The", "flight", "is", "late", "because", "of", "the", "rain"]}]}]},
{"id": 15, "vi": "làm ơn", "note": "Thêm please vào đầu câu mệnh lệnh hoặc trong câu hỏi Can/Could you please + động từ? để nhờ vả lịch sự.", "pivot": {"t": "please", "ph": "PLIZ"}, "branches": [{"steps": [{"t": "call", "ph": "CÔL", "vi": "gọi", "hl": []}, {"t": "please call", "ph": "PLIZ CÔL", "vi": "làm ơn gọi", "hl": ["please"]}, {"t": "Please call a taxi for me.", "ph": "PLIZ CÔL Ơ TÉC-XI PHO MI", "vi": "Làm ơn gọi giúp tôi một chiếc taxi.", "hl": ["Please"], "tokens": ["Please", "call", "a", "taxi", "for", "me"]}]}, {"steps": [{"t": "wait", "ph": "UÂYT", "vi": "đợi", "hl": []}, {"t": "please wait", "ph": "PLIZ UÂYT", "vi": "làm ơn đợi", "hl": ["please"]}, {"t": "Can you please wait here?", "ph": "KEN YU PLIZ UÂYT HIA", "vi": "Bạn làm ơn đợi ở đây nhé?", "hl": ["please"], "tokens": ["Can", "you", "please", "wait", "here"]}]}, {"steps": [{"t": "repeat", "ph": "RI-PIT", "vi": "nhắc lại", "hl": []}, {"t": "please repeat", "ph": "PLIZ RI-PIT", "vi": "làm ơn nhắc lại", "hl": ["please"]}, {"t": "Could you please repeat that?", "ph": "CÚD YU PLIZ RI-PIT ĐÉT", "vi": "Bạn làm ơn nhắc lại được không?", "hl": ["please"], "tokens": ["Could", "you", "please", "repeat", "that"]}]}]},
{"id": 16, "vi": "đừng", "note": "Don't + động từ nguyên mẫu đặt đầu câu để bảo ai đừng làm gì; thêm Please phía trước cho lịch sự.", "pivot": {"t": "don't", "ph": "DOUNT"}, "branches": [{"steps": [{"t": "worry", "ph": "UA-RI", "vi": "lo lắng", "hl": []}, {"t": "don't worry", "ph": "DOUNT UA-RI", "vi": "đừng lo", "hl": ["don't"]}, {"t": "Don't worry about me.", "ph": "DOUNT UA-RI Ơ-BAO MI", "vi": "Đừng lo cho tôi.", "hl": ["Don't"], "tokens": ["Don't", "worry", "about", "me"]}]}, {"steps": [{"t": "touch", "ph": "TÁCH", "vi": "chạm vào", "hl": []}, {"t": "don't touch", "ph": "DOUNT TÁCH", "vi": "đừng chạm vào", "hl": ["don't"]}, {"t": "Please don't touch the paintings.", "ph": "PLIZ DOUNT TÁCH ĐƠ PÂYN-TINHZ", "vi": "Xin đừng chạm vào các bức tranh.", "hl": ["don't"], "tokens": ["Please", "don't", "touch", "the", "paintings"]}]}, {"steps": [{"t": "forget", "ph": "PHƠ-GÉT", "vi": "quên", "hl": []}, {"t": "don't forget", "ph": "DOUNT PHƠ-GÉT", "vi": "đừng quên", "hl": ["don't"]}, {"t": "Don't forget your passport.", "ph": "DOUNT PHƠ-GÉT DO PÁT-SPOT", "vi": "Đừng quên hộ chiếu của bạn.", "hl": ["Don't"], "tokens": ["Don't", "forget", "your", "passport"]}]}]},
{"id": 17, "vi": "đã", "note": "Thì quá khứ đơn: động từ có quy tắc thêm -ed (visit → visited), động từ bất quy tắc đổi dạng (go → went); câu hỏi và phủ định dùng did + động từ nguyên mẫu.", "pivot": {"t": "-ed / did", "ph": "ĐƠ / DID"}, "branches": [{"steps": [{"t": "visit", "ph": "VI-DÍT", "vi": "thăm", "hl": []}, {"t": "visited Hanoi", "ph": "VI-DI-TƠĐ HA-NOI", "vi": "đã thăm Hà Nội", "hl": ["visited"]}, {"t": "I visited Hanoi last year.", "ph": "AI VI-DI-TƠĐ HA-NOI LÁT YIA", "vi": "Năm ngoái tôi đã đi thăm Hà Nội.", "hl": ["visited"], "tokens": ["I", "visited", "Hanoi", "last", "year"]}]}, {"steps": [{"t": "go", "ph": "GÔU", "vi": "đi", "hl": []}, {"t": "went to the market", "ph": "UENT TU ĐƠ MA-KỊT", "vi": "đã đi chợ", "hl": ["went"]}, {"t": "We went to the market yesterday.", "ph": "UY UENT TU ĐƠ MA-KỊT YÉT-TƠ-ĐÂY", "vi": "Hôm qua chúng tôi đã đi chợ.", "hl": ["went"], "tokens": ["We", "went", "to", "the", "market", "yesterday"]}]}, {"steps": [{"t": "eat", "ph": "IT", "vi": "ăn", "hl": []}, {"t": "did you eat", "ph": "DID YU IT", "vi": "bạn đã ăn", "hl": ["did"]}, {"t": "What did you eat today?", "ph": "UÓT DID YU IT TU-ĐÂY", "vi": "Hôm nay bạn đã ăn gì?", "hl": ["did"], "tokens": ["What", "did", "you", "eat", "today"]}]}]},
{"id": 18, "vi": "sẽ", "note": "will + động từ nguyên mẫu để nói việc sẽ làm hoặc dự đoán; be going to + động từ cho dự định đã có kế hoạch.", "pivot": {"t": "will", "ph": "UYL"}, "branches": [{"steps": [{"t": "call", "ph": "CÔL", "vi": "gọi", "hl": []}, {"t": "will call", "ph": "UYL CÔL", "vi": "sẽ gọi", "hl": ["will"]}, {"t": "I will call you tomorrow.", "ph": "AI UYL CÔL YU TU-MO-RÔU", "vi": "Ngày mai tôi sẽ gọi cho bạn.", "hl": ["will"], "tokens": ["I", "will", "call", "you", "tomorrow"]}]}, {"steps": [{"t": "rain", "ph": "RÂYN", "vi": "mưa", "hl": []}, {"t": "will rain", "ph": "UYL RÂYN", "vi": "sẽ mưa", "hl": ["will"]}, {"t": "I think it will rain.", "ph": "AI THINK IT UYL RÂYN", "vi": "Tôi nghĩ trời sẽ mưa.", "hl": ["will"], "tokens": ["I", "think", "it", "will", "rain"]}]}, {"steps": [{"t": "visit", "ph": "VI-DÍT", "vi": "thăm", "hl": []}, {"t": "going to visit", "ph": "GÔU-INH TU VI-DÍT", "vi": "sẽ đi thăm", "hl": ["going to"]}, {"t": "We are going to visit Hue.", "ph": "UY A GÔU-INH TU VI-DÍT HUẾ", "vi": "Chúng tôi sẽ đi thăm Huế.", "hl": ["going to"], "tokens": ["We", "are", "going", "to", "visit", "Hue"]}]}]}
]
